{
  "name": "@insightst-design/theme",
  "version": "1.0.0",
  "description": "洞察时空设计系统主题包 — core tokens + Ant Design adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./index.css": "./dist/index.css",
    "./tokens.json": "./dist/tokens.json",
    "./antd": {
      "types": "./dist/antd/index.d.ts",
      "import": "./dist/antd/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && tsx src/tokens/generate.ts",
    "dev": "tsup --watch",
    "generate": "tsx src/tokens/generate.ts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "antd": "^5.0.0 || ^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "design-system",
    "theme",
    "tokens",
    "antd",
    "insightst"
  ],
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "restricted"
  }
}
